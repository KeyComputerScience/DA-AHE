+def calibrate_bundle(training: Sequence[TraceRow], holdout: Sequence[TraceRow],
+                     actions: Sequence[Action], *, delay_threshold: float,
+                     loss_threshold: float, **calibration_options: Any) -> dict[str, Any]:
+    """Fit the frozen model and causal signed DPP predictors on identical seeds.
+
+    Only training rows fit DPP coefficients. Heldout rows validate schema/state
+    consistency and supply model empirical radii; evaluation data never fit any
+    predictor. Features are [1,z_t]; targets are signed realized excesses after
+    a_t. Exported coefficients are estimates, not hard safety certificates.
