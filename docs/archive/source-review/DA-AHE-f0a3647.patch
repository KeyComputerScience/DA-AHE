+name: Source and protocol validation
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: daahe-ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  unit-and-portable-c:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with:
+          python-version: '3.11.11'
+      - name: Install declared development dependencies
+        run: python -m pip install -e '.[dev]'
+      - name: Verify committed source manifest before generating anything
+        run: python -m daahe verify-manifest manifest.json --root .
+      - name: Unit and rejection tests without native PQ provider
+        run: python -m pytest -q -m 'not pq' --junitxml=runs/unit-tests.xml
+      - name: Build portable C core and independent known-answer tests
+        run: |
+          cmake -S embedded -B build/embedded -DBUILD_TESTING=ON
+          cmake --build build/embedded --parallel 2
+          ctest --test-dir build/embedded --output-on-failure
+      - name: Capture actual environment
+        if: always()
+        run: python tools/capture_environment.py --output runs/unit-environment.json
+      - name: Preserve actual logs
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: unit-and-portable-c-evidence
+          path: |
+            runs/unit-tests.xml
+            runs/unit-environment.json
+            build/embedded/Testing/Temporary/LastTest.log
+          if-no-files-found: warn
+
+  real-ml-dsa-and-data-path:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
+    env:
+      OQS_INSTALL_PATH: ${{ github.workspace }}/external/oqs-install
+      LD_LIBRARY_PATH: ${{ github.workspace }}/external/oqs-install/lib
+      LIBOQS_COMMIT: 5a1a854b0dc9f2141bdc771c555ee60c37950183
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with:
+          python-version: '3.11.11'
+      - name: Install native build tools
+        run: sudo apt-get update && sudo apt-get install -y cmake ninja-build build-essential libssl-dev
+      - name: Fetch exact native liboqs 0.16.0 commit
+        run: |
+          git init external/liboqs
+          git -C external/liboqs remote add origin https://github.com/open-quantum-safe/liboqs.git
+          git -C external/liboqs fetch --depth 1 origin "$LIBOQS_COMMIT"
+          git -C external/liboqs checkout --detach FETCH_HEAD
+          test "$(git -C external/liboqs rev-parse HEAD)" = "$LIBOQS_COMMIT"
+          cmake -S external/liboqs -B external/liboqs/build -G Ninja \
+            -DBUILD_SHARED_LIBS=ON -DOQS_BUILD_ONLY_LIB=ON \
+            -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_PREFIX="$OQS_INSTALL_PATH"
+          cmake --build external/liboqs/build --parallel 2
+          cmake --install external/liboqs/build
+      - name: Install pinned wrapper and test dependencies
+        run: python -m pip install -e '.[dev,pq]'
+      - name: Verify committed source manifest
+        run: python -m daahe verify-manifest manifest.json --root .
+      - name: Execute real ML-DSA tests explicitly
+        run: python -m pytest -q -m pq --junitxml=runs/pq-tests.xml
+      - name: Exercise all three reconstructed profiles with real signatures
+        run: |
+          python -m daahe demo --profile pi0 --participants 3 --output runs/pi0
+          python -m daahe demo --profile pi1 --participants 3 --output runs/pi1
+          python -m daahe demo --profile pi2 --participants 3 --output runs/pi2
+          python -m daahe demo --profile without_intdb2 --participants 3 --output runs/raw
+          python -m daahe demo --profile pi0 --participants 16 --output runs/pi0-capacity
+          python -m daahe demo --profile pi1 --participants 14 --output runs/pi1-capacity
+          python -m daahe demo --profile pi2 --participants 12 --output runs/pi2-capacity
+      - name: Capture actual environment
+        if: always()
+        run: python tools/capture_environment.py --output runs/pq-environment.json
+      - name: Preserve reports without private ledgers or keys
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: real-pq-reference-evidence
+          path: |
+            runs/pq-tests.xml
+            runs/pq-environment.json
+            runs/pi0/report.json
+            runs/pi1/report.json
+            runs/pi2/report.json
+            runs/raw/report.json
+            runs/pi0-capacity/report.json
+            runs/pi1-capacity/report.json
+            runs/pi2-capacity/report.json
+          if-no-files-found: warn
+
+# These jobs validate reference behavior only. They do not run the missing author
+# INET/Contiki experiments or certify 128.1 bits, 2^-128, 10 KiB or paper figures.
+# Workflow source was authored but never uploaded or executed during delivery.
+
