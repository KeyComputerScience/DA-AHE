+    }
+    memcpy(out, partial, sizeof(partial));
+    daahe_wipe(partial, sizeof(partial));
+    return 1;
+reject:
+    daahe_wipe(partial, sizeof(partial));
+    daahe_wipe(out, DAAHE_TAG_DIM * sizeof(*out));
+    return 0;
