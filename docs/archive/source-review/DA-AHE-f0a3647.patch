+            db.execute("PRAGMA synchronous=FULL")
+            db.execute("BEGIN IMMEDIATE")
+            row = db.execute("SELECT payload_digest, envelope FROM emissions "
+                             "WHERE ticket_digest=? AND source_id=? AND nonce=?",
+                             identity).fetchone()
+            if row is None:
+                db.execute("INSERT INTO emissions "
