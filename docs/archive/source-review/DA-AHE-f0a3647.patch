+        observed = violation_state(row.telemetry[2], row.telemetry[1], row.telemetry[6],
+                                   delay_threshold=delay_threshold, loss_threshold=loss_threshold,
+                                   decoding_margin=1.0)
+        realized = violation_state(row.metrics[1], row.next_loss, row.metrics[3],
+                                   delay_threshold=delay_threshold, loss_threshold=loss_threshold,
+                                   decoding_margin=1.0)
+        if any(not math.isclose(x, y, rel_tol=1e-9, abs_tol=1e-12)
+               for x, y in zip(row.state, observed)):
+            raise ValueError("current state disagrees with F_t observations and declared thresholds")
+        if any(not math.isclose(x, y, rel_tol=1e-9, abs_tol=1e-12)
+               for x, y in zip(row.next_state, realized)):
+            raise ValueError("next state disagrees with a_t outcomes and declared thresholds")
+    model = calibrate(training, holdout, actions, **calibration_options)
+    regularization = float(calibration_options.get("regularization", 0.001))
+    dpp_models = {}
